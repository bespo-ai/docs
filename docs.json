{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Script.it",
  "description": "Automations in a world of agents",
  "colors": {
    "primary": "#020617",
    "light": "#020617",
    "dark": "#020617"
  },
  "favicon": "/logo/icon.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": ["copy", "view", "assistant"],
    "display": "header"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Templates",
          "href": "https://script.it/templates"
        },
        {
          "anchor": "Pricing",
          "href": "https://script.it/pricing"
        },
        {
          "anchor": "Changelog",
          "href": "https://script.it/changelog"
        }
      ]
    },
    "directory": "none",
    "groups": [
      {
        "group": "Get started",
        "pages": ["introduction", "quickstart", "core-concepts"]
      },
      {
        "group": "Scripts",
        "pages": ["scripts/overview", "scripts/blocks", "scripts/templates"]
      },
      {
        "group": "Sessions",
        "pages": ["sessions/overview", "sessions/chat", "sessions/files"]
      },
      {
        "group": "Triggers",
        "pages": [
          "triggers/overview",
          "triggers/schedule",
          "triggers/webhook",
          "triggers/integrations"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/overview",
          "integrations/connecting",
          "integrations/custom-webhook"
        ]
      },
      {
        "group": "For developers",
        "pages": ["developers/overview"]
      },
      {
        "group": "Account",
        "pages": ["account/workspace", "account/billing", "account/security"]
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.script.it/login"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/script-dot-it/"
    }
  },
  "appearance": {
    "strict": true,
    "default": "light"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://script.it"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#FFFFFF"
    }
  },
  "thumbnails": {
    "appearance": "light"
  }
}
